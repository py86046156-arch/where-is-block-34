# ==============================================================================
# Google Maps Platform Configuration
# ==============================================================================
# 1. Create an API Key in Google Cloud Console:
#    https://console.cloud.google.com/google/maps-apis/credentials
#
# 2. Required APIs to enable:
#    - Maps JavaScript API
#    - Geocoding API
#    - Aerial View API (if using 3D aerial video flyovers)
#
# 3. Security Best Practice (Application Restrictions):
#    - Restrict this key to "Websites (HTTP referrers)"
#    - Add referrers: http://localhost:* and https://yourdomain.com/*
# ==============================================================================

VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ==============================================================================
# OpenStreetMap (OSM) & Routing Configuration
# ==============================================================================
# Standard OSM Tile Server (Free, requires attribution to OpenStreetMap contributors)
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# CartoDB Light Tile Server (Clean Apple Maps/SaaS aesthetic)
VITE_CARTO_LIGHT_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png

# OSRM Pedestrian Footpath Routing Engine
VITE_OSRM_FOOT_ROUTING_URL=https://router.project-osrm.org/route/v1/foot
